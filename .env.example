# Copy to .env and fill in, then run: uv run --env-file .env hc-wrapup-web
# and open http://127.0.0.1:8080 (not localhost).

# From a Hardcover developer app of type "Web app (server-side)"
# with the redirect URI http://127.0.0.1:8080/callback
HARDCOVER_CLIENT_ID=
HARDCOVER_CLIENT_SECRET=

# Any random string of 32+ characters; it encrypts the cookies. To make one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
